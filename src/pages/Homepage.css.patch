/* Modern Product Showcase Section */
.modernProductShowcase {
  margin: 40px 20px;
  padding: 20px;
  background: #fff;
  border-radius: 20px;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1);
  color: var(--secondary-color);
  text-align: center;
}

.modernProductShowcase .sectionTitle {
  font-size: 2.2rem;
  font-weight: 900;
  margin-bottom: 30px;
  color: var(--primary-color);
  letter-spacing: 1.2px;
  text-transform: uppercase;
  font-family: 'Poppins', sans-serif;
}

.modernProductCardsContainer {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 30px;
  justify-items: center;
}

.modernProductCard {
  background: #fafafa;
  border-radius: 16px;
  box-shadow: 0 4px 12px rgba(255, 60, 120, 0.15);
  padding: 20px;
  display: flex;
  flex-direction: column;
  align-items: center;
  transition: transform 0.3s ease, box-shadow 0.3s ease;
  cursor: pointer;
}

.modernProductCard:hover {
  transform: translateY(-10px);
  box-shadow: 0 12px 24px rgba(255, 60, 120, 0.3);
}

.modernProductImageWrapper {
  width: 160px;
  height: 160px;
  border-radius: 50%;
  overflow: hidden;
  box-shadow: 0 0 15px rgba(255, 60, 120, 0.3);
  margin-bottom: 20px;
  transition: box-shadow 0.3s ease;
}

.modernProductCard:hover .modernProductImageWrapper {
  box-shadow: 0 0 30px rgba(255, 60, 120, 0.6);
}

.modernProductImage {
  width: 100%;
  height: 100%;
  object-fit: cover;
  border-radius: 50%;
  transition: transform 0.3s ease;
}

.modernProductCard:hover .modernProductImage {
  transform: scale(1.1) rotate(3deg);
}

.modernProductName {
  font-size: 1.2rem;
  font-weight: 700;
  margin-bottom: 10px;
  color: var(--secondary-color);
  text-align: center;
}

.modernProductPrice {
  font-size: 1rem;
  font-weight: 600;
  color: var(--primary-color);
  margin-bottom: 20px;
}

.buyNowButton {
  background: var(--primary-color);
  border: none;
  border-radius: 30px;
  padding: 12px 30px;
  color: white;
  font-weight: 700;
  font-size: 1rem;
  cursor: pointer;
  box-shadow: 0 6px 15px rgba(255, 60, 120, 0.4);
  transition: background 0.3s ease, box-shadow 0.3s ease;
  outline-offset: 2px;
}

.buyNowButton:hover,
.buyNowButton:focus {
  background: #ff1a5a;
  box-shadow: 0 8px 20px rgba(255, 26, 90, 0.6);
  outline: none;
}

/* Responsive adjustments */
@media (max-width: 768px) {
  .modernProductCardsContainer {
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 20px;
  }

  .modernProductImageWrapper {
    width: 120px;
    height: 120px;
    margin-bottom: 15px;
  }

  .modernProductName {
    font-size: 1rem;
  }

  .modernProductPrice {
    font-size: 0.9rem;
    margin-bottom: 15px;
  }

  .buyNowButton {
    padding: 10px 25px;
    font-size: 0.9rem;
  }
}

@media (max-width: 480px) {
  .modernProductCardsContainer {
    grid-template-columns: 1fr;
    gap: 15px;
  }

  .modernProductImageWrapper {
    width: 100%;
    height: auto;
    border-radius: 16px;
  }

  .modernProductImage {
    border-radius: 16px;
  }
}
